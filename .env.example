# ===========================================================================
# SUPERAGENT — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ===========================================================================

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-64
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.superagent.local
DJANGO_SETTINGS_MODULE=config.settings.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Supabase Postgres) ------------------------------------------
# Use the *pooled* connection string for the web tier, direct for migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key: BACKEND ONLY. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# --- BYOK credential encryption -------------------------------------------
# Fernet key, base64url 32 bytes. Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Rotate by adding a new key first in the list, re-encrypting, then removing old.
BYOK_ENCRYPTION_KEYS=
BYOK_ACTIVE_KEY_ID=k1

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- GitHub App ------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# --- Daytona cloud execution ----------------------------------------------
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET_REGION=eu
DAYTONA_ENABLED=false

# --- Local runner ----------------------------------------------------------
LOCAL_RUNNER_PAIRING_TTL_SECONDS=600
LOCAL_RUNNER_WS_URL=ws://localhost:8000/ws/runner/
LOCAL_RUNNER_MAX_COMMAND_SECONDS=900

# --- Guardrails ------------------------------------------------------------
MAX_TASK_COST_USD=5.00
DEFAULT_MONTHLY_SPEND_CAP_USD=50.00
RATE_LIMIT_PER_MINUTE=120

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
