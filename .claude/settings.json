{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(apps/api/**)",
      "Edit(apps/web/**)",
      "Edit(apps/local-runner/**)",
      "Edit(packages/**)",
      "Edit(docs/**)",
      "Edit(.claude/skills/**)",
      "Write(apps/api/**)",
      "Write(apps/web/**)",
      "Write(apps/local-runner/**)",
      "Write(packages/**)",
      "Write(docs/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(pytest:*)",
      "Bash(python manage.py makemigrations:*)",
      "Bash(python manage.py migrate:*)",
      "Bash(python manage.py check:*)",
      "Bash(python -m compileall:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(docker:*)",
      "Bash(chmod:*)",
      "Write(.env)",
      "Edit(.env)",
      "Write(.mcp.json)",
      "Edit(.claude/settings.json)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Edit(migrations/**/0*.py)"
    ]
  },
  "env": {
    "DJANGO_SETTINGS_MODULE": "config.settings.dev",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh" } ] },
      { "matcher": "Write|Edit", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-python.sh" } ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-summary.sh" } ] }
    ]
  }
}
